# --- Database ---
# Railway provides this automatically once you add a PostgreSQL service
# and link it to this app. Copy the same value here for local dev.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Generate a long random string: `openssl rand -base64 48`
JWT_SECRET=replace-this-with-a-long-random-string

# Used only once, by `npm run migrate`, to create your first admin login.
# Change the password immediately after first login via Admin → Settings.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# --- CORS ---
# Your deployed frontend URL (e.g. https://lukman-portfolio.vercel.app)
FRONTEND_URL=http://localhost:5173

# --- Uploads (Cloudinary) ---
# Sign up free at cloudinary.com, then copy these three values from your
# dashboard home page. Required for portfolio image/video uploads to work
# and to persist across redeploys (Railway's local disk does not persist).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
# Choose one: paystack | flutterwave | monnify
PAYMENT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLW_WEBHOOK_HASH=

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://api.monnify.com

# Your deployed FRONTEND url, used for payment redirect callbacks
PUBLIC_APP_URL=http://localhost:5173

PORT=4000
